datasource db {
    provider        = "sqlite"
    url             = env("DATABASE_URL")
}

generator client {
    provider        = "prisma-client-js"
    binaryTargets   = ["native", "debian-openssl-1.1.x"]
}

enum TournamentStatus {
    WAITING_FOR_PLAYERS
    IN_PROGRESS
    COMPLETED
    CANCELLED
}

enum InvitationStatus {
    PENDING
    ACCEPTED
    DECLINED
}

enum ParticipantStatus {
    WAITING
    READY
    PLAYING
    ELIMINATED
    WINNER
}

enum TournamentMatchStatus {
    SCHEDULED
    IN_PROGRESS
    COMPLETED
}

model Tournament {
    id                  String              @id @default(cuid())
    organizerId         String
    title               String
    status              TournamentStatus    @default(WAITING_FOR_PLAYERS)
    bestOf              Int                 @default(1)
    maxPlayers          Int                 @default(8)
    currentRound        Int                 @default(0)
    createdAt           DateTime            @default(now())
    startedAt           DateTime?
    completedAt         DateTime?

    invitations         TournamentInvitation[]
    participants        TournamentParticipant[]
    matches             TournamentMatch[]

    @@index([organizerId])
    @@index([status])
}

model TournamentInvitation {
    id                  String              @id @default(cuid())
    tournamentId        String
    tournament          Tournament          @relation(fields: [tournamentId], references: [id])
    inviteeId           String
    inviterId           String
    status              InvitationStatus    @default(PENDING)
    invitedAt           DateTime            @default(now())
    respondedAt         DateTime?

    @@unique([tournamentId, inviteeId])
    @@index([inviteeId])
}

model TournamentParticipant {
    id                  String              @id @default(cuid())
    tournamentId        String
    tournament          Tournament          @relation(fields: [tournamentId], references: [id])
    playerId            String
    isAi                Boolean             @default(false)
    aiLevel             Int?
    seed                Int?
    status              ParticipantStatus   @default(WAITING)
    joinedAt            DateTime            @default(now())

    matchesAsPlayerA    TournamentMatch[]   @relation("PlayerA")
    matchesAsPlayerB    TournamentMatch[]   @relation("PlayerB")
    matchesWon          TournamentMatch[]   @relation("Winner")

    @@unique([tournamentId, playerId])
    @@index([tournamentId])
}

model TournamentMatch {
    id                  String                  @id @default(cuid())
    tournamentId        String
    tournament          Tournament              @relation(fields: [tournamentId], references: [id])
    roundIndex          Int
    bracketPosition     Int
    playerAId           String?
    playerA             TournamentParticipant?  @relation("PlayerA", fields: [playerAId], references: [id])
    playerBId           String?
    playerB             TournamentParticipant?  @relation("PlayerB", fields: [playerBId], references: [id])
    winnerId            String?
    winner              TournamentParticipant?  @relation("Winner", fields: [winnerId], references: [id])
    status              TournamentMatchStatus   @default(SCHEDULED)
    scoreA              Int                     @default(0)
    scoreB              Int                     @default(0)
    scheduledAt         DateTime?
    completedAt         DateTime?
    createdAt           DateTime                @default(now())

    @@unique([tournamentId, roundIndex, bracketPosition])
    @@index([tournamentId, roundIndex])
}