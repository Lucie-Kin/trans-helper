datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-1.1.x"]
}

enum PlayerLevel {
  NOOB
  MIDS
  PRO
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
  BLOCKED
}

model User {
  id         String   @id @default(cuid())
  email      String   @unique
  username   String   @unique
  provider   String
  providerId String?
  avatarUrl  String?
  createdAt  DateTime @default(now())

  stats                   PlayerStats?
  sentFriendRequests      Friendship[] @relation("FriendRequestsSent")
  receivedFriendRequests  Friendship[] @relation("FriendRequestsReceived")

  @@index([provider, providerId])
}

model PlayerStats {
  id                String        @id @default(cuid())
  userId            String        @unique
  user              User          @relation(fields:[userId], references:[id])
  PlayerLevel       PlayerLevel   @default(NOOB)
  eloRating         Int           @default(1000)
  matchesPlayed     Int           @default(0)
  wins              Int           @default(0)
  losses            Int           @default(0)
  cumulativePoints  Int           @default(0)
  lastActiveAt      DateTime      @default(now())
  createdAt         DateTime      @default(now())
  updateAt          DateTime      @updateAt
}

model Friendship {
  id               String         @id @default(cuid())
  requesterId      String
  addresseeId      String
  requester        User           @relation("FriendRequestsSent", fields: [requesterId], references:[id])
  addressee        User           @relation("FriendRequestsReceived", fields: [addresseeId], references: [id])
  status           FriendshipStatus @default(PENDING)
  createdAt        DateTime      @default(now())
  updateAt         DateTime      @updateAt

  @@unique([requesterId, addresseeId])
  @@index([addresseeId])
}
